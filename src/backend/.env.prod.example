# ─────────────────────────────────────────────────────────────────────────
# Production environment example
# Provide these values via your deployment's secret manager / env injection.
# Do NOT store real production secrets in a committed file.
# ─────────────────────────────────────────────────────────────────────────

# Default values are commented out.

# ── Environment ──────────────────────────────────────────────────────────
# ENVIRONMENT=production
# LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# DATABASE_USER=app
# DATABASE_NAME=app

# DATABASE_PASSWORD is required for production. It should be a strong secret.
# Must be 8–128 characters. Generate a strong secret, e.g.:
#   openssl rand -base64 24
DATABASE_PASSWORD=


# ── Health ───────────────────────────────────────────────────────────────
# HEALTH_FULL_TOKEN is optional.
# Protects GET /health/full. Must be 32–128 characters. Generate with:
#   openssl rand -hex 32
# HEALTH_FULL_TOKEN=

# ── CORS ─────────────────────────────────────────────────────────────────
# Exact origin of the production frontend (no trailing slash, no wildcard).
FRONTEND_ORIGIN=https://example.com
