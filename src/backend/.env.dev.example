# ─────────────────────────────────────────────────────────────────────────
# Development environment example
# Copy to `.env` and adjust: cp .env.dev.example .env
# NEVER commit the resulting `.env` file.
# ─────────────────────────────────────────────────────────────────────────

# Default values are commented out.

# ── Environment ──────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ── Database (matches the local PostgreSQL Docker container) ──────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=app
DATABASE_NAME=app

DATABASE_PASSWORD=database-password

# ── Health ───────────────────────────────────────────────────────────────
# Protects GET /health/full. Must be 32–128 characters.
HEALTH_FULL_TOKEN=dev-health-token-0123456789abcdef0123

# ── CORS ─────────────────────────────────────────────────────────────────
# Origin of the frontend dev server (Vite default port shown).
FRONTEND_ORIGIN=http://localhost:5173
