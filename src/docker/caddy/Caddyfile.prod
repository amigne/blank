{
	admin off
	email {$ACME_EMAIL}
}

{$APP_ADDRESS} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@api path /api/*
	handle @api {
		reverse_proxy backend:8000 {
			health_uri /health/live
			health_interval 15s
			health_timeout 3s
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}
