#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT_DIR"

# ── Secrets (test) ─────────────────────────────────────────────────────
SECRETS_TEST_DIR="secrets/test"
mkdir -p "$SECRETS_TEST_DIR"

# Generate a random postgres password if none exists.
if [[ ! -f "$SECRETS_TEST_DIR/postgres_password" ]]; then
    openssl rand -base64 18 | tr -d '\n/+=' > "$SECRETS_TEST_DIR/postgres_password"
    echo "Generated: $SECRETS_TEST_DIR/postgres_password"
fi

# Generate a random health token if none exists.
if [[ ! -f "$SECRETS_TEST_DIR/health_full_token" ]]; then
    openssl rand -hex 32 > "$SECRETS_TEST_DIR/health_full_token"
    echo "Generated: $SECRETS_TEST_DIR/health_full_token"
fi

# ── Environment file ───────────────────────────────────────────────────
ENV_FILE="env/test.env"
ENV_EXAMPLE="env/test.env.example"

if [[ ! -f "$ENV_FILE" ]] && [[ -f "$ENV_EXAMPLE" ]]; then
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    echo "Created: $ENV_FILE (from example)"
elif [[ ! -f "$ENV_FILE" ]]; then
    echo "ERROR: Neither $ENV_FILE nor $ENV_EXAMPLE found." >&2
    exit 1
fi

echo "Test environment ready."
