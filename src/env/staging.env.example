MYAPP_PROJECT_NAME=myapp-staging

# Replace these examples with immutable images produced by CI.
MYAPP_POSTGRES_IMAGE=postgres:18.4-trixie
MYAPP_CADDY_IMAGE=caddy:2.11.4-alpine
MYAPP_BACKEND_IMAGE=registry.example.invalid/myapp-backend:1.0.0
# MYAPP_FRONTEND_IMAGE=registry.example.invalid/myapp-frontend:1.0.0

MYAPP_APP_ENVIRONMENT=staging
# MYAPP_NODE_ENVIRONMENT=production
MYAPP_LOG_LEVEL=INFO

# MYAPP_PUBLIC_BASE_URL=https://staging.example.invalid
# MYAPP_PUBLIC_API_BASE_URL=/api

MYAPP_HEALTH_FULL_TOKEN_FILE=/etc/myapp/secrets/staging/health_full_token

MYAPP_DATABASE_NAME=myapp
MYAPP_DATABASE_USER=myapp
MYAPP_POSTGRES_PASSWORD_SECRET_FILE=/etc/myapp/secrets/staging/postgres_password

# MYAPP_BACKEND_SECRET_KEY_FILE=/etc/myapp/secrets/staging/backend_secret_key

MYAPP_CADDYFILE=./docker/caddy/Caddyfile.staging
MYAPP_APP_ADDRESS=staging.example.invalid
MYAPP_ACME_EMAIL=admin@example.invalid
