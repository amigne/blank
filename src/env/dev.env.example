# WARNING: This is an example file. Replace placeholder values with your own.
# NEVER commit real secrets — copy to dev.env and edit that file instead.

MYAPP_PROJECT_NAME=myapp-dev

MYAPP_POSTGRES_IMAGE=postgres:18.4-trixie
MYAPP_CADDY_IMAGE=caddy:2.11.4-alpine
MYAPP_BACKEND_IMAGE=myapp-backend:dev
MYAPP_FRONTEND_IMAGE=myapp-frontend:dev

MYAPP_PYTHON_IMAGE=python:3.14.6-slim
MYAPP_NODE_IMAGE=node:24.18.0-alpine

MYAPP_APP_ENVIRONMENT=development
# MYAPP_NODE_ENVIRONMENT=development
MYAPP_LOG_LEVEL=DEBUG

MYAPP_HEALTH_FULL_TOKEN_FILE=./secrets/dev/health_full_token

# MYAPP_PUBLIC_BASE_URL=http://localhost:8080
# MYAPP_PUBLIC_API_BASE_URL=/api
MYAPP_CORS_ORIGIN=http://localhost:8080

MYAPP_DATABASE_NAME=myapp
MYAPP_DATABASE_USER=myapp
MYAPP_DATABASE_PORT=5432
MYAPP_POSTGRES_PASSWORD_SECRET_FILE=./secrets/dev/postgres_password

# MYAPP_BACKEND_SECRET_KEY_FILE=./secrets/dev/backend_secret_key

MYAPP_CADDYFILE=./docker/caddy/Caddyfile.dev
MYAPP_APP_ADDRESS=http://localhost
MYAPP_ACME_EMAIL=

MYAPP_HTTP_PORT=8080
