# WARNING: This is an example file. Replace placeholder values with your own.
# NEVER commit real secrets — copy to prod.env and edit that file instead.

MYAPP_PROJECT_NAME=myapp-prod

# Prefer immutable digests produced and signed by CI.
MYAPP_POSTGRES_IMAGE=postgres:18.4-trixie
MYAPP_CADDY_IMAGE=caddy:2.11.4-alpine
MYAPP_BACKEND_IMAGE=registry.example.invalid/myapp-backend@sha256:REPLACE_WITH_BACKEND_DIGEST
# MYAPP_FRONTEND_IMAGE=registry.example.invalid/myapp-frontend@sha256:REPLACE_WITH_FRONTEND_DIGEST

MYAPP_APP_ENVIRONMENT=production
# MYAPP_NODE_ENVIRONMENT=production
# MYAPP_LOG_LEVEL=INFO

# MYAPP_PUBLIC_BASE_URL=https://example.invalid
# MYAPP_PUBLIC_API_BASE_URL=/api
MYAPP_CORS_ORIGIN=https://example.invalid

MYAPP_HEALTH_FULL_TOKEN_FILE=/etc/myapp/secrets/prod/health_full_token

MYAPP_DATABASE_NAME=myapp
MYAPP_DATABASE_USER=myapp
MYAPP_POSTGRES_PASSWORD_SECRET_FILE=/etc/myapp/secrets/prod/postgres_password

# MYAPP_BACKEND_SECRET_KEY_FILE=/etc/myapp/secrets/prod/backend_secret_key

MYAPP_CADDYFILE=./docker/caddy/Caddyfile.prod
MYAPP_APP_ADDRESS=example.invalid
MYAPP_ACME_EMAIL=admin@example.invalid
